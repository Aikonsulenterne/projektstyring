# AI Team Space – environment contract (docs/handoff/06_REPOSITORY_AND_SETUP.md).
# Copy to .env.local. Never commit real values. Nothing here is NEXT_PUBLIC.

# "demo" = browser-only prototype data.
# "open" = shared database, NO login: anyone with the link can read and edit.
# Anything else (or unset) = production with Entra login, which fails closed
# until every variable below is configured.
APP_MODE=demo

# PostgreSQL (production/integration). Local example: see compose.yaml.
# Supabase: DATABASE_URL = the pooled "Transaction" connection string (port 6543),
# DIRECT_URL = the "Session pooler" string (port 5432), used only for migrations.
DATABASE_URL=
DIRECT_URL=

# Auth.js with Microsoft Entra ID (single tenant). Awaiting IT approval;
# do not guess tenant ids, client ids or redirect URLs.
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
ALLOWED_TENANT_ID=
APP_BASE_URL=
